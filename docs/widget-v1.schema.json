{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cove.local/schemas/widget-v1.schema.json",
  "title": "Cove Inline Widget v1",
  "description": "Structural schema. Apply INLINE_WIDGETS.md semantic/runtime checks as well.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "version",
    "id",
    "state",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "primitive": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "min",
                "max",
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "and",
                "or",
                "not",
                "if",
                "concat",
                "round"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "add",
                      "sub",
                      "mul",
                      "div",
                      "min",
                      "max",
                      "eq",
                      "ne",
                      "lt",
                      "lte",
                      "gt",
                      "gte",
                      "and",
                      "or"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "args": {
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "round",
                      "not"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "args": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "if"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "args": {
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "state": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/primitive"
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "set"
            },
            "values": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "send"
            },
            "text": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/expression"
            },
            "style": {
              "enum": [
                "body",
                "title",
                "caption"
              ]
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Stack": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Stack"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "axis": {
              "enum": [
                "vertical",
                "horizontal"
              ]
            },
            "spacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "Grid": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Grid"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "spacing": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Card"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "title": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Button"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "$ref": "#/$defs/expression"
            },
            "action": {
              "$ref": "#/$defs/action"
            },
            "disabled": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "label",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Input": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Input"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "bind": {
              "$ref": "#/$defs/identifier"
            },
            "placeholder": {
              "type": "string",
              "maxLength": 4000
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4000
            }
          },
          "required": [
            "label",
            "bind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Slider": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Slider"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "bind": {
              "$ref": "#/$defs/identifier"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "label",
            "bind",
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Metric"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "value": {
              "$ref": "#/$defs/expression"
            },
            "unit": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "label",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Progress"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "value": {
              "$ref": "#/$defs/expression"
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Transition"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/expression"
            },
            "style": {
              "enum": [
                "fade",
                "slide"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "Choice": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Choice"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "bind": {
              "$ref": "#/$defs/identifier"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "label",
            "bind",
            "options"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Image": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Image"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
            },
            "alt": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Disclosure": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Disclosure"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "bind": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Audio": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Audio"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "visible": {
          "$ref": "#/$defs/expression"
        },
        "props": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
            },
            "label": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "src",
            "label"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "$ref": "#/$defs/Stack"
        },
        {
          "$ref": "#/$defs/Grid"
        },
        {
          "$ref": "#/$defs/Card"
        },
        {
          "$ref": "#/$defs/Button"
        },
        {
          "$ref": "#/$defs/Input"
        },
        {
          "$ref": "#/$defs/Slider"
        },
        {
          "$ref": "#/$defs/Metric"
        },
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "$ref": "#/$defs/Transition"
        },
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "$ref": "#/$defs/Image"
        },
        {
          "$ref": "#/$defs/Disclosure"
        },
        {
          "$ref": "#/$defs/Audio"
        }
      ]
    }
  }
}
