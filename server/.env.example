# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COVE_TOKEN=replace-with-an-independent-random-secret-at-least-24-characters
COVE_HOST=127.0.0.1
COVE_PORT=8796
COVE_DATA_DIR=/var/lib/cove
# Create a dedicated workspace with your own instructions, not someone else's identity or session.
COVE_WORKSPACE=/srv/cove-workspace
# Use an isolated host configuration/login if other assistants run on the same machine.
# CODEX_HOME=/var/lib/cove/codex
COVE_RUNTIME=app-server
COVE_CODEX_COMMAND="codex app-server -c 'model_reasoning_effort=\"high\"'"
# Optional model override; leave empty for the host default. Use a model available to your account.
COVE_MODEL=
COVE_EFFORT=high
# Unanswered active-turn console approvals are declined after this deadline.
COVE_APPROVAL_TIMEOUT=120
COVE_SANDBOX=read-only
COVE_APPROVAL_POLICY=on-request
COVE_TURN_TIMEOUT=1800
# Developer-only services are optional and are NOT supplied by this repository.
COVE_PULSE_PATH=
# COVE_OB_BUCKETS_PATH=
# COVE_MEMORY_DB=
# COVE_CHAT_DB=
# COVE_COLLAR_URL=
# COVE_COLLAR_TOKEN=
# COVE_TRAVEL_TOKEN_FILE=
# Optional App-event ingest credential: independent 32–256 character ASCII secret.
# COVE_SHORTCUTS_TOKEN=
# Optional cove_send_file roots. Empty disables paths; create dedicated export directories first.
# Colon-separated absolute directories; never /, a home directory, or an identity root.
COVE_EXPORT_ROOTS=
# Optional actual APNs; all four required, independent Cove bundle/signing account.
# COVE_APNS_TEAM_ID=
# COVE_APNS_KEY_ID=
# COVE_APNS_KEY_PATH=/etc/cove/AuthKey_PRIVATE.p8
# COVE_APNS_BUNDLE_ID=
# COVE_APNS_SANDBOX=1

# Optional paid text-to-speech. No provider key, voice identity or private profile is bundled.
# Provider selection is explicit; an unknown outcome never retries on another provider.
# Existing installations retain MiniMax unless changed by the operator.
# COVE_VOICE_DEFAULT=minimax
# COVE_MINIMAX_API_KEY=
# COVE_MINIMAX_VOICE_ID=
# To use ElevenLabs, configure both fields and select voice=elevenlabs or change the default.
# Key file: absolute path, regular file, current service uid, permissions 0600; no symlinks.
# COVE_ELEVENLABS_KEY_PATH=/etc/cove/elevenlabs.key
# COVE_ELEVENLABS_VOICE_ID=
