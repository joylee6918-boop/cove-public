# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COVE_TOKEN=replace-with-an-independent-random-secret-at-least-24-characters
COVE_HOST=127.0.0.1
COVE_PORT=8796
COVE_DATA_DIR=/var/lib/cove
# Must contain assistant identity/memory instructions; never an active other applications thread ID.
COVE_WORKSPACE=/srv/cove-workspace
COVE_CODEX_COMMAND="codex app-server -c 'model_reasoning_effort=\"high\"'"
# Optional model override; leave empty for the host default. Use a model available to your account.
COVE_MODEL=
COVE_EFFORT=high
# Unanswered active-turn console approvals are declined after this deadline.
COVE_APPROVAL_TIMEOUT=120
COVE_SANDBOX=read-only
COVE_APPROVAL_POLICY=on-request
COVE_TURN_TIMEOUT=1800
COVE_PULSE_PATH=
# Optional cove_send_file roots. Empty disables paths; create dedicated export directories first.
# Colon-separated absolute directories; never /, a home directory, or an identity root.
COVE_EXPORT_ROOTS=
# Optional actual APNs; all four required, independent Cove bundle/signing account.
# COVE_APNS_TEAM_ID=
# COVE_APNS_KEY_ID=
# COVE_APNS_KEY_PATH=/etc/cove/AuthKey_PRIVATE.p8
# COVE_APNS_BUNDLE_ID=
# COVE_APNS_SANDBOX=1
